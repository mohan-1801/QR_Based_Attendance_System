[Unit]
Description=Gunicorn daemon for Smart QR Code Attendance System
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/QR_Based_Attendance
ExecStart=/var/www/QR_Based_Attendance/venv/bin/gunicorn --config gunicorn.conf.py smart_qr_attendance.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
