# Production Environment Variables Template

# Security
SECRET_KEY=your-production-super-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=smart-qr-attendance.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://smart-qr-attendance.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (PostgreSQL URL for Render/Railway/Docker)
# Format: postgres://username:password@hostname:port/database_name
DATABASE_URL=postgres://qr_user:qr_password_secure@localhost:5432/smart_qr_db

# Email SMTP Settings (Gmail / Outlook)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Smart QR System <your_email@gmail.com>

# HTTPS Security Options (Set to False if testing HTTP locally without SSL)
SECURE_SSL_REDIRECT=True
